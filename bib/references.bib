@article{tech-leadership-and-5g-patent-portfolios,
author = {David J. Teece},
title ={Technological Leadership and 5G Patent Portfolios: Guiding Strategic Policy and Licensing Decisions},
journal = {California Management Review},
volume = {63},
number = {3},
pages = {5-34},
year = {2021},
doi = {10.1177/00081256211007584},
URL = { https://doi.org/10.1177/00081256211007584 },
eprint = { https://doi.org/10.1177/00081256211007584 }
,
    abstract = { Whether it’s mobile phones or autonomous cars or telemedicine, a well-functioning robust 5G ecosystem will require licensing executives to have a deep understanding of the need for timely licensing to support technology development and adoption. It is important that the parties to patent licensing agreements understand that value doesn’t depend on the numerosity of patent portfolios, but on use value. The ecosystem is impaired when parties to licensing transactions are recalcitrant and advance bogus indicia of value. The 5G stakes are sufficiently high that top management oversight is likely required. }
}

