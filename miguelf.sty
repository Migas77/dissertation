\newcommand{\hide}[1]{}
\newcommand{\plan}[1]{\textcolor{ForestGreen}{PLAN: #1}}
\newcommand{\later}[1]{\textcolor{blue}{CHECK LATER: #1}}
\newcommand{\review}[1]{\textcolor{red}{FOR REVIEW: #1}}
\newcommand{\fix}[1]{\textcolor{YellowOrange}{FIX: #1}}
\usepackage[table]{xcolor}          % Row table shading
\usepackage{wasysym}                % Half circle icon
\usepackage{longtable}              % long table in multile pages
\usepackage{booktabs}               % required for the same visual as tabular
\usepackage{xcolor}                 % required for the same visual as tabular
\usepackage[dvipsnames]{xcolor}     % other colors (e.g. ForestGreen)
