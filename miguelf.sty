\newcommand{\customparagraph}[1]{%
  \vspace{1.5ex plus 0.5ex minus 0.2ex}%
  \noindent\textit{#1}\par%
  \vspace{0.5em}%
}
\usepackage{pdflscape}              % horizontal pages
\usepackage{enumitem}               % custom enumerations
\newenvironment{custenumerate}[1]
    {\begin{enumerate}[label=#1\arabic*., labelwidth=2em, leftmargin=3.75em, align=left]}
    {\end{enumerate}}
